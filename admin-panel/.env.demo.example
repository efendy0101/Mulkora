# Yalnızca Firebase Emulator Suite için örnekler
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mulkora.firebaseapp.com
