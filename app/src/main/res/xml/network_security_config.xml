<?xml version="1.0" encoding="utf-8"?>
<!--
    Ağ güvenlik yapılandırması.
    Production: yalnızca güvenli HTTPS bağlantısına izin verilir.
    Debug: Firebase Emulator Suite için localhost'a cleartext izni verilir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Firebase Emulator Suite için debug yapılandırması -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>