<?xml version="1.0" encoding="utf-8"?>
<!--
    KVKK ve güvenlik gereklilikleri doğrultusunda:
    - Oturum token'ları, tercihler ve kimlik bilgileri bulut yedeklemesinden hariç tutulur.
    - CLAUDE.md §27: Hassas veriler gizlilik politikasına uygun şekilde korunmalıdır.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>